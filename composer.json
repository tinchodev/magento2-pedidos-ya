{
    "name": "nx6/pedidosya",
    "description": "Magento 2 module that exports the catalog and promotions to PedidosYa over SFTP",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento",
        "magento2",
        "magento-module",
        "pedidosya",
        "sftp",
        "catalog-export",
        "promotions",
        "marketplace"
    ],
    "homepage": "https://github.com/tinchodev/pedidos-ya",
    "support": {
        "issues": "https://github.com/tinchodev/pedidos-ya/issues",
        "source": "https://github.com/tinchodev/pedidos-ya"
    },
    "authors": [
        {
            "name": "Martin",
            "email": "amartin.c137@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "magento/framework": ">=103.0",
        "magento/module-catalog": ">=104.0",
        "magento/module-store": ">=101.1",
        "magento/module-config": ">=101.2",
        "magento/module-cron": ">=100.4",
        "magento/module-inventory-api": ">=1.2",
        "magento/module-inventory-sales-api": ">=1.3",
        "phpseclib/phpseclib": "~3.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Nx6\\PedidosYa\\": ""
        }
    },
    "archive": {
        "exclude": [
            "/sample",
            "/.github",
            "/README.md"
        ]
    }
}
